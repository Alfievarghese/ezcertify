# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ezcertify

# Redis (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# QR Verification base URL (frontend URL — update for production)
VERIFY_BASE_URL=http://localhost:5173/verify

# Frontend URL (for CORS — update for Vercel production URL)
CLIENT_URL=http://localhost:5173

# File storage (local for dev, switch to S3/R2 for production)
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_FILE_SIZE_MB=50

# Retention (hours)
UPLOAD_RETENTION_HOURS=2
GENERATED_RETENTION_HOURS=48

# Rendering
MAX_WORKER_CONCURRENCY=4
